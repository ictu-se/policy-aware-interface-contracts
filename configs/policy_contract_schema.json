{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/policy-contract.schema.json",
  "title": "OpenAPI Policy Contract Extension",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resource",
    "action",
    "authentication",
    "function_authorization",
    "inventory"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
        "path": {"type": "string", "pattern": "^/"}
      }
    },
    "types": {
      "type": "object",
      "additionalProperties": {"enum": ["Bool", "String", "StringSet", "Integer", "Record"]}
    },
    "resource": {"type": "string", "minLength": 1},
    "action": {
      "enum": ["read", "create", "update", "delete", "search", "aggregate"]
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "integrity"],
      "properties": {
        "required": {"type": "boolean"},
        "schemes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "integrity": {"enum": ["valid_signature", "not_applicable"]},
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subject": {"type": "string", "minLength": 1},
            "roles": {"type": "string", "minLength": 1},
            "jurisdiction": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "function_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["any_role"],
      "properties": {
        "any_role": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "object_scope": {"$ref": "#/$defs/predicateDisjunction"},
    "jurisdiction_scope": {"$ref": "#/$defs/jurisdictionPredicate"},
    "purpose_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "source"],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": {"enum": ["token_claim", "header", "query"]},
            "name": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "property_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forbidden_request_fields": {"$ref": "#/$defs/fieldList"},
        "response_fields_by_role": {"$ref": "#/$defs/fieldMap"},
        "response_fields_by_purpose": {"$ref": "#/$defs/fieldMap"},
        "aggregation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum_group_size", "count_field"],
          "properties": {
            "minimum_group_size": {"type": "integer", "minimum": 2},
            "count_field": {"type": "string", "minLength": 1}
          }
        },
        "sensitivity": {
          "type": "object",
          "additionalProperties": {
            "enum": ["public", "internal", "personal", "identity", "financial", "health", "child", "disciplinary"]
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {"type": "boolean"},
        "event_type": {"type": "string", "minLength": 1},
        "probe": {"type": "string", "minLength": 1},
        "match": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["subject", "operation", "resource_id", "decision"]}
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "behavior"],
      "properties": {
        "status": {"enum": ["active", "deprecated", "retired"]},
        "behavior": {"enum": ["normal", "deprecation_header", "unavailable"]}
      }
    },
    "side_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracle"],
      "properties": {"oracle": {"type": "string", "minLength": 1}}
    },
    "dependent_clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["when", "require"],
        "properties": {
          "when": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}},
          "require": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}}
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "negative_fixture", "oracle", "secure_control"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1},
        "negative_fixture": {"type": "object"},
        "oracle": {"type": "string", "minLength": 1},
        "secure_control": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "string",
      "pattern": "^(caller|token|path|query|header|request|response|fixture|literal)\\.[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "subject_operand", "resource_operand"],
      "properties": {
        "relation": {"enum": ["equal", "contains", "member_of", "ancestor_of"]},
        "subject_operand": {"$ref": "#/$defs/reference"},
        "resource_operand": {"$ref": "#/$defs/reference"},
        "resolver": {"type": "string", "minLength": 1}
      },
      "allOf": [{
        "if": {"properties": {"relation": {"const": "ancestor_of"}}},
        "then": {"required": ["resolver"]}
      }]
    },
    "predicateDisjunction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["any_of"],
      "properties": {
        "any_of": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/predicate"}
        }
      }
    },
    "jurisdictionPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparator", "caller_operand", "resource_operand"],
      "properties": {
        "comparator": {"enum": ["equal", "member_of", "ancestor_of"]},
        "caller_operand": {"$ref": "#/$defs/reference"},
        "resource_operand": {"$ref": "#/$defs/reference"},
        "resolver": {"type": "string", "minLength": 1}
      },
      "allOf": [{
        "if": {"properties": {"comparator": {"const": "ancestor_of"}}},
        "then": {"required": ["resolver"]}
      }]
    },
    "fieldList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "fieldMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/fieldList"}
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operand", "operator", "value"],
      "properties": {
        "operand": {"$ref": "#/$defs/reference"},
        "operator": {"enum": ["eq", "in"]},
        "value": {}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation", "value"],
      "properties": {
        "obligation": {"enum": ["field", "decision", "audit"]},
        "value": {}
      }
    }
  }
}
